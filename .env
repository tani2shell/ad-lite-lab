# samba-ad-lite settings for the stefgo/samba-ad entrypoint. NO secrets here.
SAMBA_HOST_ADDRESS=172.31.60.10
SAMBA_REALM=LITE.CORP
SAMBA_WORKGROUP=LITE
SAMBA_INTERFACES=127.0.0.1/8 172.31.60.10/24
# isolated lab: BIND recurses for the range our attacker paths come from
SAMBA_DNS_ALLOW_RECURSION=localnets
# allow LDAP simple bind without TLS (pentest tooling)
SAMBA_LDAP_REQUIRE_STRONG_AUTH=no
SAMBA_LOG_LEVEL=1
TZ=Asia/Tokyo
